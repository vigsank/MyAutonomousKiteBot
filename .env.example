# ============================================================
#  My Autonomous Kite Vault - Environment Configuration
#  Copy this file to `.env` and fill in your values.
#  NEVER commit `.env` to version control.
# ============================================================

# ------------------------------------------------------------
# Market data providers (two independent selections)
# ------------------------------------------------------------
# BACKTEST_PROVIDER is used by backtest.ts / optimize.ts (historical only).
#   yahoo (default) - account-free, no API key, no signup. Great for backtests.
#   openbb          - account-free OpenBB local REST API (see OPENBB_BASE_URL below).
#   kite            - real Zerodha Kite history (requires KITE_API_KEY/ACCESS_TOKEN).
BACKTEST_PROVIDER=yahoo

# OpenBB local REST API base URL (only used when BACKTEST_PROVIDER=openbb).
# OpenBB is an open-source Python platform. Run once: pip install "openbb[all]" && openbb-api
OPENBB_BASE_URL=http://127.0.0.1:6900

# LIVE_PROVIDER is used by index.ts for live (paper/real) trading.
#   kite (default)  - Zerodha Kite websocket (real-time ticks + live history).
LIVE_PROVIDER=kite

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=info

# ------------------------------------------------------------
# Zerodha Kite Connect (LIVE provider; also BACKTEST_PROVIDER=kite)
# ------------------------------------------------------------
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_ROOT=https://api.kite.trade

# ------------------------------------------------------------
# AI / LLM - sentiment analysis
# LLM_PROVIDER controls which provider is active:
#   ollama   -> Ollama Cloud (default); LiteLLM acts as fallback on 429/quota
#   litellm  -> LiteLLM is the sole provider; Ollama is not used at all
#   openai   -> OpenAI direct; no fallback
# ------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=llama3.3
OLLAMA_MODELS=llama3.3,qwen2.5,mistral,gemma3,mistral-large-3:675b,gpt-oss:120b,qwen3.5:397b
LLM_ENSEMBLE_MODELS=mistral-large-3:675b,qwen3.5:397b,gpt-oss:120b
LLM_FAST_ENSEMBLE_MODELS=deepseek-v4-flash:preview,gpt-oss:20b,gemma4:31b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini
#LLM_JSON_MODE=true
LLM_TIMEOUT_MS=60000

# ------------------------------------------------------------
# LiteLLM fallback (SAP AI Core / any OpenAI-compatible proxy)
# When enabled, activates automatically on Ollama 429/quota errors.
# ------------------------------------------------------------
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=anthropic--claude-sonnet-latest
LITELLM_ENSEMBLE_MODELS=anthropic--claude-sonnet-latest,gemini-2.5-pro,gpt-5.5
LITELLM_FAST_ENSEMBLE_MODELS=anthropic--claude-haiku-latest,anthropic--claude-sonnet-latest

# ------------------------------------------------------------
# Telegram - human-in-the-loop (leave empty to disable; all
# notifications are written to the SQLite DB regardless)
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------
# Quantitative risk configuration (all in INR)
# ------------------------------------------------------------
AVAILABLE_CAPITAL=500000
MAX_DAILY_DRAWDOWN=5000
MAX_TRADE_ALLOCATION=20000
# Max % of capital a single position may use (diversification).
MAX_POSITION_WEIGHT_PCT=20
AUTO_TRADE_TICKET_THRESHOLD=100000000

# ------------------------------------------------------------
# Strategy - core RSI mean-reversion
# ------------------------------------------------------------
RSI_ENTRY_THRESHOLD=30
RSI_EXIT_THRESHOLD=70
STOP_LOSS_PERCENT=4
TRADE_COOLDOWN_MINUTES=15

# ------------------------------------------------------------
# Strategy - volatility-adaptive risk
# ------------------------------------------------------------
ATR_STOP_MULTIPLIER=2
RISK_PER_TRADE_PERCENT=1
BAR_INTERVAL_SECONDS=60

# ------------------------------------------------------------
# Strategy - regime & confirmation filters
# ------------------------------------------------------------
ADX_TREND_THRESHOLD=25
VOLUME_CONFIRM_MULTIPLIER=1.5
MAX_SIMULTANEOUS_ENTRIES=2

# ------------------------------------------------------------
# Strategy - circuit breaker & session timing
# ------------------------------------------------------------
CIRCUIT_BREAKER_TRADES=3
CIRCUIT_BREAKER_WINDOW_MINUTES=30
CIRCUIT_BREAKER_HALT_MINUTES=60
SKIP_FIRST_MINUTES=30
SKIP_LAST_MINUTES=30

# ------------------------------------------------------------
# Strategy - breakout / trend-following (STRATEGY_MODE=breakout)
# ------------------------------------------------------------
# Buy when price breaks above the prior N-bar high. Best on daily bars.
BREAKOUT_LOOKBACK=20
# ATR trailing stop multiplier (ratchets stop up as price makes new highs).
BREAKOUT_TRAIL_ATR_MULT=2
# Optional LLM analyst pre-trade filter (soft; RiskEngine stays the hard gate).
ANALYST_ENABLED=false
ANALYST_REJECT_THRESHOLD=70
# --- Paper cost model (realism; set to 0 for ideal fills) ---
PAPER_SLIPPAGE_BPS=2
PAPER_BROKERAGE_BPS=3
PAPER_BROKERAGE_MAX=20
PAPER_STATUTORY_BPS=10
PAPER_GST_PCT=18

# --- Trade quality gates ---
MIN_RISK_REWARD=1.5
TARGET_ATR_MULTIPLIER=3
REGIME_GATING_ENABLED=false
MIN_SIGNAL_CONFIDENCE=0

# ------------------------------------------------------------
# Options layer (SAFE, switchable) - OPTIONS_ENABLED=true
# ------------------------------------------------------------
# Options are risky (leverage + theta). This layer is SAFE by design:
#   - BUYS options only (defined risk = premium; max loss is the premium)
#   - Enforces per-trade premium cap + total exposure cap
#   - Priced via Black-Scholes
# Set OPTIONS_ENABLED=true to turn it on (default OFF).
OPTIONS_ENABLED=false
# Max premium (₹) per single option trade.
MAX_OPTION_PREMIUM_PER_TRADE=5000
# Max total premium (₹) at risk across all open options.
MAX_OPTIONS_EXPOSURE=20000
# Days to expiry for the options bought.
OPTION_EXPIRY_DAYS=30
# Strike offset % toward OTM (cheaper, needs a bigger move).
OPTION_STRIKE_OFFSET_PCT=2

# ------------------------------------------------------------
# Mock paper-trading mode (kite-paper-node)
# ------------------------------------------------------------
# Set to true to use the local in-process mock (no broker/network).
# Requires non-empty KITE_API_KEY / KITE_ACCESS_TOKEN.
PAPER_TRADING=false

# ------------------------------------------------------------
# Exit & regime-adaptive knobs
# ------------------------------------------------------------
# Move the stop to breakeven once price moves favorably by this many ATRs.
BREAKEVEN_ATR_MULT=1
# RSI buffer below the entry threshold that overrides the ADX regime filter.
DEEP_OVERSOLD_BUFFER=10
# Auto-select the strategy mode from the detected market regime (replaces single-mode).
REGIME_ADAPTIVE=true

# --- News search (live web search for sentiment) --------------------------
# TinyFish Search/Fetch is free (no credits). Google News RSS is always on.
TINYFISH_API_KEY=
TINYFISH_MAX_RESULTS=5
TINYFISH_TIMEOUT_MS=15000

# --- Read-only Zerodha Kite MCP (hosted or self-hosted) ---------------------
# Hosted https://mcp.kite.trade/mcp needs interactive OAuth + a paid Kite sub.
# For headless use, self-host the Go server read-only and point here.
# OFF by default so paper/mock runs are unaffected.
KITE_MCP_ENABLED=true
KITE_MCP_URL=http://127.0.0.1:4000/mcp
KITE_MCP_TIMEOUT_MS=5000

# --- Agent runtime (probe schedule + cadence) -------------------------------
# Enables the scheduled agent fleet: 10-min pass loop + 3 daily probe runs
# (pre-open 09:00, mid-session 12:00, pre-close 15:00 IST). Verdicts only —
# execution is the core bot's job via RiskEngine.
AGENTS_ENABLED=false
AGENTS_INTERVAL_MS=600000
AGENTS_PROBE_PRE_OPEN=09:00
AGENTS_PROBE_MID_SESSION=12:00
AGENTS_PROBE_PRE_CLOSE=15:00
# --- Dev/test knobs (default OFF; turn ON only while developing) ----------
# AGENTS_PROBE_ALWAYS=true -> run the probe immediately on every start,
#                             regardless of IST time (else it fires only at
#                             09:00 / 12:00 / 15:00 IST).
# AGENTS_FORCE_SIGNAL=true -> force the strategist to propose a paper trade for
#                             AGENTS_FORCE_SIGNAL_SYMBOL, to exercise the
#                             execution path (still RiskEngine-gated, paper-only).
AGENTS_PROBE_ALWAYS=false
AGENTS_FORCE_SIGNAL=false
AGENTS_FORCE_SIGNAL_SYMBOL=ITC

# --- Bollinger mean-reversion entry (validated signal) ----------------------
# Buy close < lower band + RSI oversold, exit at middle band. Tuned via
# walk-forward sweep: sd=1.5, rsi=30 -> 61% symbol consistency, +ve expectancy.
BOLLINGER_ENTRY=true
BOLLINGER_PERIOD=20
BOLLINGER_STD_DEV=1.5
BOLLINGER_RSI_ENTRY=30

# --- Holdings review (manage existing positions) ----------------------------
# Book partial profit when an open position is up this much (%).
HOLDINGS_PROFIT_TARGET_PCT=8
# Trim a position when it exceeds this % of capital (rebalance).
HOLDINGS_TARGET_WEIGHT_PCT=10
