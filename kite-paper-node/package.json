{
  "name": "kite-paper-node",
  "version": "1.0.0",
  "description": "Zero-dependency paper trading mock engine for Zerodha Kite Connect — 100% JIT data generation, drop-in replacement for kiteconnect",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "kite-paper-node": "dist/bin/cli.js"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "docs/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/bin/cli.ts",
    "start": "node dist/bin/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "zerodha",
    "kite",
    "kiteconnect",
    "paper-trading",
    "mock",
    "testing",
    "algorithmic-trading",
    "backtesting",
    "simulation",
    "jit",
    "market-simulator"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "kiteconnect": "^4.0.0 || ^5.0.0"
  },
  "optionalDependencies": {
    "express": "^4.22.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
