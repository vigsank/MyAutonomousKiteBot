{
  "name": "my-autonomous-kite-vault",
  "version": "0.1.0",
  "description": "Personal agentic stock trading bot for Zerodha Kite with human-in-the-loop control, paper trading, and AI-driven sentiment analysis.",
  "license": "GPL-3.0",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server/index.js",
    "dev": "ts-node src/server/index.ts",
    "typecheck": "tsc --noEmit && npm run agents:typecheck",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "agents:typecheck": "tsc --noEmit -p src/agents/tsconfig.json",
    "lint": "tsc --noEmit && npm run agents:typecheck",
    "simulate": "ENV_FILE=.env.test ts-node test/backtest/simulate.ts",
    "ab:compare": "ENV_FILE=.env.test ts-node test/backtest/ab_compare.ts",
    "agents:dryrun": "ENV_FILE=.env.test ts-node src/agents/dryrun.ts",
    "backtest": "ENV_FILE=.env.test ts-node test/backtest/backtest.ts",
    "optimize": "ENV_FILE=.env.test ts-node test/backtest/optimize.ts",
    "chart": "ENV_FILE=.env.test ts-node test/backtest/chart_equity.ts",
    "test:backtest": "ENV_FILE=.env.test ts-node test/backtest/test_backtest_path.ts",
    "dev:ui": "npm --prefix src/client run dev",
    "dev:all": "concurrently -n server,client -c blue,green \"npm run dev\" \"npm run dev:ui\"",
    "build:ui": "npm --prefix src/client run build",
    "typecheck:ui": "npm --prefix src/client run typecheck",
    "mock:ui": "ENV_FILE=.env.test ts-node test/backtest/mock_ui.ts",
    "validate:strategy": "ENV_FILE=.env.test ts-node test/backtest/walk_forward.ts",
    "audit:code": "node run_code_audit.mjs",
    "audit:strategy": "node run_strategy_audit.mjs",
    "audit:profit": "node run_strategy_profit_audit.mjs",
    "test:momentum": "ENV_FILE=.env.test ts-node test/momentum_test.ts",
    "test:risk": "ENV_FILE=.env.test ts-node test/risk_regression_test.ts",
    "test:indicators": "ENV_FILE=.env.test ts-node test/indicators_test.ts",
    "test:live": "ENV_FILE=.env.test ts-node test/live_readiness_test.ts",
    "test:feedback": "ENV_FILE=.env.test ts-node test/feedback_test.ts",
    "test:agents": "ENV_FILE=.env.test ts-node test/agents_blackboard_test.ts",
    "test:execution": "ENV_FILE=.env.test ts-node test/execution_test.ts",
    "test:tax": "ENV_FILE=.env.test ts-node test/tax_test.ts",
    "test:shadow": "ENV_FILE=.env.test ts-node test/shadow_book_test.ts",
    "test:authority": "ENV_FILE=.env.test ts-node test/ai_authority_test.ts",
    "test:ladder": "ENV_FILE=.env.test ts-node test/go_live_ladder_test.ts",
    "test:unit": "npm run test:momentum && npm run test:risk && npm run test:indicators && npm run test:live && npm run test:feedback && npm run test:agents && npm run test:execution && npm run test:tax && npm run test:shadow && npm run test:authority && npm run test:ladder",
    "validate:momentum": "ENV_FILE=.env.test ts-node test/backtest/momentum_walk_forward.ts",
    "score:shadow": "ENV_FILE=.env.test ts-node scripts/score_shadow_book.ts",
    "status:golive": "ENV_FILE=.env.test ts-node scripts/go_live_status.ts",
    "attribute:leaks": "ENV_FILE=.env.test ts-node test/backtest/leak_attribution.ts",
    "estimate:survivorship": "ENV_FILE=.env.test ts-node test/backtest/survivorship_bias.ts",
    "ci": "npm run test:unit && npm run validate:momentum"
  },
  "keywords": [
    "zerodha",
    "kite",
    "trading",
    "bot",
    "paper-trading",
    "typescript",
    "human-in-the-loop"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@debut/indicators": "^1.2.0",
    "better-sqlite3": "^9.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "kiteconnect": "^4.0.1",
    "node-telegram-bot-api": "^0.64.0",
    "openai": "^4.50.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "rss-parser": "^3.13.0",
    "ws": "^8.18.0",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/node-telegram-bot-api": "^0.64.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
